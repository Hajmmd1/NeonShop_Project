@page "{id}"
@model ServiceHost.Pages.ProductModel
@{
    ViewData["Title"] = Model.Product.Name;
    ViewData["keywords"] = Model.Product.Keywords;
    ViewData["metaDescription"] = Model.Product.MetaDescription;
}
<div class="product-page container-sm"

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 mb-0">
            <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-light">صفحه اصلی</a></li>
            <li class="breadcrumb-item"><a asp-page="/ProductCategory" asp-route-id="@Model.Product.CategorySlug" class="text-decoration-none text-light">@Model.Product.Category</a></li>
            <li class="breadcrumb-item active text-neon">@Model.Product.Name</li>
        </ol>
    </nav>

    <!-- Product top section -->
    <div class="row g-4 align-items-start flex-row-reverse">
        <!-- Images -->
        <div class="col-lg-6">
            <div class="neon-card p-3">
                <div class="swiper main-swiper mySwiperMain">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <img src="~/ProductPictures/@Model.Product.Picture" alt="@Model.Product.Picture" />
                        </div>
                        @foreach (var picture in Model.Product.Pictures)
                        {
                            <div class="swiper-slide">
                                <img src="~/ProductPictures/@picture.Picture" alt="@picture.PictureAlt" title="@picture.PictureTitle" />
                            </div>
                        }
                    </div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                </div>
                <div class="swiper thumb-swiper mySwiperThumbs mt-3">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <img src="~/ProductPictures/@Model.Product.Picture" />
                        </div>
                        @foreach (var picture in Model.Product.Pictures)
                        {
                            <div class="swiper-slide">
                                <img src="~/ProductPictures/@picture.Picture" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Info -->
        <div class="col-lg-6">
            <div class="neon-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="text-secondary mb-2">@Model.Product.Category</h5>
                    <h2 class="product-title mb-3">@Model.Product.Name</h2>

                    <div class="price-box mb-3">
                        @if (Model.Product.HasDiscount)
                        {
                            <span class="discounted">@Model.Product.Price تومان</span>
                            <span>@Model.Product.PriceWithDiscount تومان</span>
                        }
                        else
                        {
                            <span>@Model.Product.Price تومان</span>
                        }
                    </div>

                    <div class="mb-3">
                        <p class="mb-1 small">کد محصول: @Model.Product.Code</p>
                        @if (Model.Product.IsInStock)
                        {
                            <span class="text-success small">موجود در انبار</span>
                        }
                        else
                        {
                            <span class="text-danger small">ناموجود</span>
                        }
                    </div>

                    <p>@Model.Product.ShortDescription</p>
                </div>

                <div>
                    <button class="btn-neon w-100 mt-2"
                            onclick="addToCart('@Model.Product.Id', '@Model.Product.Name', '@Model.Product.DoublePrice', '@Model.Product.Picture')">
                        <i class="fa fa-shopping-bag ms-1"></i> افزودن به سبد خرید
                    </button>
                    <div class="social-share-buttons mt-3">
                        <h6>اشتراک‌گذاری</h6>
                        <ul>
                            <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                            <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                            <li><a href="#"><i class="fa fa-pinterest"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="mt-5">
        <ul class="nav nav-tabs justify-content-center" id="productTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">توضیحات</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="review-tab" data-bs-toggle="tab" data-bs-target="#review" type="button" role="tab">نظرات</button>
            </li>
        </ul>
        <div class="tab-content" id="productTabContent">
            <div class="tab-pane fade show active" id="desc" role="tabpanel">
                @Model.Product.Description
            </div>

        <div class="col-lg-12">
            <div class="tab-slider-wrapper product-description-review-container  section-space--inner">
                <nav>
                    <div class="nav nav-tabs justify-content-center" id="nav-tab"
                         role="tablist">
                        <a class="nav-item nav-link active" id="description-tab"
                           data-toggle="tab" href="#product-description" role="tab"
                           aria-selected="true">
                            توضیحات
                        </a>
                        <a class="nav-item nav-link" id="review-tab" data-toggle="tab"
                           href="#review" role="tab" aria-selected="false">
                            نظرات (@Model.Product.Comments.Count)
                        </a>
                    </div>
                </nav>
                <div class="tab-content" id="nav-tabContent">
                    <div class="tab-pane fade show active" id="product-description"
                         role="tabpanel" aria-labelledby="description-tab">
                        <div class="product-description">
                            @Model.Product.Description
                        </div>
                    </div>
                    <div class="tab-pane fade" id="review" role="tabpanel"
                         aria-labelledby="review-tab">
                        <div class="product-rating-wrap">
                            @*<div class="rating-list">
                                                            <div class="sin-list float-right">
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <span>(5)</span>
                                                            </div>
                                                            <div class="sin-list float-right">
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <span>(3)</span>
                                                            </div>
                                                            <div class="sin-list float-right">
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <span>(1)</span>
                                                            </div>
                                                            <div class="sin-list float-right">
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <span>(0)</span>
                                                            </div>
                                                            <div class="sin-list float-right">
                                                                <i class="fa fa-star"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <i class="fa fa-star-o"></i>
                                                                <span>(0)</span>
                                                            </div>
                                                        </div>*@
                            @foreach (var comment in Model.Product.Comments)
                            {
                                    <div class="ratings-wrapper">
                                        <div class="sin-ratings">
                                            <div class="rating-author">
                                                <h3>@comment.Name</h3>
                                                @*<div class="rating-star">
                                                                            <i class="fa fa-star"></i>
                                                                            <i class="fa fa-star"></i>
                                                                            <i class="fa fa-star"></i>
                                                                            <i class="fa fa-star"></i>
                                                                            <i class="fa fa-star"></i>
                                                                            <span>(5)</span>
                                                                        </div>*@
                                            </div>
                                            <p>@comment.Message</p>
                                        </div>
                                    </div>
                            }

                            <div class="rating-form-wrapper fix">
                                <h3>نظر خود را به ما بگویید</h3>
                                <form method="post">
                                    <div class="rating-form row">
                                        <div class="col-md-6 col-12 form-group">
                                            <label for="name">نام:</label>
                                            <input id="name" placeholder="مثال: علی علوی" name="name" type="text">
                                        </div>
                                        <div class="col-md-6 col-12 form-group">
                                            <label for="email">ایمیل:</label>
                                            <input id="email" placeholder="مثال: contact@atriya.com" name="email" type="text">
                                        </div>
                                        <div class="col-12 form-group">
                                            <label for="your-review">نظر شما:</label>
                                            <textarea name="message" id="message" placeholder="نظر خود را بنویسید ..."></textarea>
                                        </div>
                                        <input type="hidden" name="ownerRecordId" value="@Model.Product.Id"/>
                                        @*<input type="hidden" name="type" value="@CommnetManagement.Infrastructure.EFCore.CommentType.Product" />*@
                                        <input type="hidden" name="productSlug" value="@Model.Product.Slug"/>
                                        <div class="col-12">
                                            <input value="ارسال" type="submit">
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Swiper CDN -->
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const thumbs = new Swiper(".mySwiperThumbs", {
            spaceBetween: 8,
            slidesPerView: 4,
            freeMode: true,
            watchSlidesProgress: true,
            breakpoints: { 0: { slidesPerView: 3 }, 768: { slidesPerView: 4 } }
        });
        new Swiper(".mySwiperMain", {
            spaceBetween: 10,
            navigation: { nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" },
            thumbs: { swiper: thumbs },
        });
    });
</script>