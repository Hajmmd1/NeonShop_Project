<script>
    VANTA.NET({
      el: "#NetLandingBg",
      mouseControls: true,
      touchControls: true,
      gyroControls: false,
      minHeight: 200.00,
      minWidth: 200.00,
      scale: 1.00,
      scaleMobile: 0.5,
      color: "#00ffff",
      backgroundColor: "#212529",
      points: 20.00,
      maxDistance: 21.00
    })
</script>
