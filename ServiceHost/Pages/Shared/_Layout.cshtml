<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (ViewData["Title"] != null)
    {
        <title>@ViewData["Title"] - فروشگاه Neon</title>
    }
    else
    {
        <title>فروشگاه لوازم دکوری</title>
    }

    <meta name="keywords" content="@ViewData["keywords"]" />
    <meta name="description" content="@ViewData["metaDescription"]" />

  @*   <link href="~/Theme/assets/css/vendors.css" rel="stylesheet">
    <link href="~/Theme/assets/css/style.css" rel="stylesheet">
    <link href="~/Theme/assets/css/Custom.css" rel="stylesheet"> *@
    <link href="~/lib/bootstrap/bootstrap.css" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" rel="stylesheet" />
    <link href="~/assets/css/root.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/css/general.css" rel="stylesheet" asp-append-version="true" />


</head>

<body data-bs-theme="dark">

@await Component.InvokeAsync("Menu")
    @RenderSection("outOfContainer",false)
    @RenderBody()



    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>
<script src="~/lib/bootstrap/bootstap.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/js/all.min.js"></script>
    <script src="~/assets/scripts/general.js" asp-append-version="true"></script>
@* <script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/Theme/assets/js/vendors.js"></script>
<script src="~/Theme/assets/js/active.js"></script>
<script src="~/Theme/assets/js/plugins.js"></script>
<script src="~/Theme/assets/js/custom.js"></script> *@

</body>

</html>