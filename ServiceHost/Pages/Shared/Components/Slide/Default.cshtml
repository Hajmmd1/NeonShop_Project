@model List<_01_ShopQuery.Contract.Slide.SlideQueryModel>

<!-- Hero Slider -->
<div class="swiper heroSwiper section-space">
    <div class="swiper-wrapper">
        @foreach (var slide in Model)
        {
            <div class="swiper-slide">
                <img src="~/ProductPictures/@slide.Picture" class="w-100 d-block" alt="@slide.PictureAlt" title="@slide.PictureTitle" />
                <div class="carousel-caption d-none d-md-block text-start">
                    <p class="fs-4 fw-light">@slide.Heading</p>
                    <h2 class="fw-bold">@slide.Title</h2>
                    <p>@slide.Text</p>
                    <a href="@slide.Link" class="btn btn-primary">
                        @slide.BtnText <i class="fa-solid fa-plus ms-2"></i>
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    <div class="swiper-pagination"></div>
</div>
<script>
    var swiper = new Swiper(".heroSwiper", {
        loop: true,
        autoplay: {
            delay: 2000,
        },
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
        effect: "slide",
        
    });
</script>

