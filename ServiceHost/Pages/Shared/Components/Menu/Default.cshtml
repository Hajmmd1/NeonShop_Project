@model _01_ShopQuery.MenuModel
<header class="sticky-top shadow-sm">
    <nav id="neonNavbar"
         data-bs-theme="dark"
         class="navbar navbar-expand-lg bg-dark navbar-light px-3  py-2 d-flex justify-content-between align-items-center">

        <!-- Logo -->
        <a class="navbar-brand" asp-page="/Index">
            <img src="~/Theme/assets/img/logo.png" alt="Logo" class="img-fluid" style="height: 40px;">
        </a>
        <li>
            <a href="javascript:void(0)" id="search-overlay-trigger">
                <i class="ion-ios-search-strong"></i>
            </a>
        </li>
        <!-- Left side (main menu) -->
        <div class="collapse navbar-collapse justify-content-center" id="mainNavbar">
            <ul class="navbar-nav mb-2 mb-lg-0 text-center">
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Index">صفحه اصلی</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="productsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        محصولات
                    </a>
                    <ul class="dropdown-menu  " aria-labelledby="productsDropdown">
                        @foreach (var category in Model.ProductCategories)
                        {
                            <li>
                                <a class="dropdown-item" asp-page="./ProductCategory" asp-route-id="@category.Slug">@category.Name</a>
                            </li>
                        }
                    </ul>

                <li class="menu-item-has-children">
                    <a>مقالات</a>
                    <ul class="sub-menu">
                        @foreach (var category in Model.ArticleCategories)
                        {
                            <li>
                                <a asp-page="./ArticleCategory" asp-route-id="@category.Slug">@category.Name</a>
                            </li>
                        }
                    </ul>
                </li>
                <li>
                </li>
            </ul>
        </div>
       
       
        <!-- Right side (icons + toggler) -->
        <div class="d-flex align-items-center gap-3">

           
            <div class="search-overlay" id="search-overlay">
                <a href="javascript:void(0)" class="close-search-overlay" id="close-search-overlay">
                    <i class="ion-ios-close-empty"></i>
                </a>
                <div class="search-form">
                    <form method="get" asp-page="/Search">
                        <input type="search" name="value" id="value" placeholder="هرچه می خواهید در فروشگاه جستجو کنید ...">
                        <button type="submit">
                            <i class="ion-android-search"></i>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Profile -->
            <div class="dropdown">
                <a href="#" class="fs-5" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa-solid fa-user"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end  " aria-labelledby="profileDropdown">
                    <li><a class="dropdown-item" asp-page="/Account">ثبت نام</a></li>
                    <li><a class="dropdown-item" asp-page="/Account">ورود</a></li>
                </ul>
            </div>

            <!-- Cart -->
            <div class="dropdown position-relative">
                <a href="#" class="fs-5 position-relative" id="cartDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cart_items_count">0</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end p-3" aria-labelledby="cartDropdown" style="width: 250px;">
                    <div id="cart_items_wrapper"></div>
                    <hr>
                    <a asp-page="/Cart" class="btn btn-outline-primary w-100">مشاهده سبد خرید</a>
                </ul>
            </div>

            <!-- Toggler (visible on all screens) -->
            <button class="navbar-toggler d-block" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>
</header>


<!-- Offcanvas (Mobile Menu) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMenu">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">منو</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body  ">
        <div class="offcanvas-mobile-search-area">
            <form action="#">
                <input type="search" placeholder="جستجو ...">
                <button type="submit">
                    <i class="fa fa-search"></i>
                </button>
            </form>
        </div>

        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" asp-page="/Index">صفحه اصلی</a>
            </li>

            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">محصولات</a>
                <ul class="dropdown-menu  ">
                    @foreach (var category in Model.ProductCategories)
                    {
                        <li>
                            <a class="dropdown-item" asp-page="./ProductCategory" asp-route-id="@category.Slug">@category.Name</a>
                        </li>
                    }
                </ul>
            </li>

            <li class="nav-item">
                <a class="nav-link" asp-page="/Contact">تماس با ما</a>
            </li>
        </ul>

        <hr>

        <h6 class="fw-bold">پروفایل من</h6>
        <ul class="list-unstyled">
            <li><a class="text-decoration-none d-block py-1" asp-page="/Account">ثبت نام</a></li>
            <li><a class="text-decoration-none d-block py-1" asp-page="/Account">ورود</a></li>
        </ul>

        <hr>

        <div>
            <h6 class="fw-bold mb-2">تماس با ما</h6>
            <p class="mb-1"><i class="fa-solid fa-phone"></i> (1245) 2456 012</p>
            <p><i class="fa-solid fa-envelope"></i> info@atriya.com</p>
        </div>

        <div class="mt-3 d-flex gap-3 justify-content-center">
            <a href="#"><i class="fa-brands fa-facebook"></i></a>
            <a href="#"><i class="fa-brands fa-twitter"></i></a>
            <a href="#"><i class="fa-brands fa-linkedin"></i></a>
            <a href="#"><i class="fa-brands fa-youtube"></i></a>
        </div>
    </div>
</div>
</div>

