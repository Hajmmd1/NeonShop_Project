@model List<_01_ShopQuery.Contract.ProductCategory.ProductCategoryQueryModel>


<section class="single-row-slider-tab-area section-space neon-section" aria-labelledby="products-section-title">
    <header class="row mb-3">
        <div class="col-12 text-center">
            <h2 id="products-section-title" class="section-title">محصولات ما</h2>
            <p class="section-subtitle">لورم ایپسوم متن ساختگی با تولید سادگی نامفهوم از صنعت چاپ و با استفاده از طراحان گرافیک است.</p>
        </div>
    </header>

    <!-- Categories swiper -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="category-swiper-wrapper">
                <div class="swiper category-swiper" aria-label="دسته‌بندی محصولات">
                    <div class="swiper-wrapper">
                        @foreach (var category in Model)
                        {
                            @if (category.Products.Count > 0 && category.Products.Any())
                            {
                                <div class="swiper-slide" role="button" tabindex="0" data-target="#product-series-@category.Id" aria-controls="product-series-@category.Id" title="@category.Name">
                                    <a href="#product-series-@category.Id" class="d-flex flex-column align-items-center text-decoration-none">
                                        <span class="category-circle" aria-hidden="true">
                                            <img src="/ProductPictures/@category.Picture" alt="@category.PictureAlt" title="@category.PictureTitle" />
                                        </span>
                                        <span class="category-title">@category.Name</span>
                                    </a>
                                </div>
                            }

                        }
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Product groups -->
    <div class="row">
        <div class="col-12">
            <main>
                @foreach (var category in Model)
                {
                    <section id="product-series-@category.Id" class="product-group" aria-labelledby="group-title-@category.Id">
                        <div class="product-group__title mb-3">
                            <h3 id="group-title-@category.Id">@category.Name</h3>
                            <div class="title-underline" aria-hidden="true"></div>
                            @if (!string.IsNullOrWhiteSpace(category.Description))
                            {
                                <small class="d-block mt-2 text-muted" style="color:#9ccfe9">@category.Description</small>
                            }
                        </div>

                        <div class="row">
                            @if (category.Products.Count > 0 && category.Products.Any())
                            {
                                @foreach (var product in category.Products)
                                {
                                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                                        <article class="product-card-horizontal d-flex align-items-center" itemscope>
                                            <a asp-page="/Product" asp-route-id="@product.Slug" class="product-image-wrapper">
                                                <img src="~/ProductPictures/@product.Picture"
                                                     alt="@product.PictureAlt"
                                                     title="@product.PictureTitle"
                                                     itemprop="image" />
                                            </a>

                                            <div class="product-info flex-grow-1">
                                                <a asp-page="/Product" asp-route-id="@product.Slug" class="text-decoration-none">
                                                    <h4 class="product-name" itemprop="name">@product.Name</h4>
                                                </a>

                                                <div class="product-price" itemprop="offers" itemscope>
                                                    @if (product.HasDiscount)
                                                    {
                                                        <span class="discounted-price" itemprop="price">@product.PriceWithDiscount تومان</span>
                                                        <span class="main-price discounted">@product.Price تومان</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="main-price" itemprop="price">@product.Price تومان</span>
                                                    }
                                                </div>

                                                <button class="btn-cart">
                                                    <i class="fas fa-shopping-cart"></i> افزودن به سبد
                                                </button>
                                            </div>
                                        </article>
                                    </div>
                                }
                            }
                        </div>
                    </section>

                }
            </main>
        </div>
    </div>
</section>
<script>
    // Initialize Swiper
    const categorySwiper = new Swiper('.category-swiper', {
      slidesPerView: 'auto',
      spaceBetween: 12,
      centeredSlides: false,
      loop: false,
      breakpoints: {
        0: { slidesPerView: 3 },
        576: { slidesPerView: 4 },
        768: { slidesPerView: 6 },
        992: { slidesPerView: 8 },
        1200: { slidesPerView: 10 }
      },
      a11y: {
        enabled: true
      }
    });

    // Smooth scroll when clicking category link (works for internal anchor)
    $(document).on('click', '.category-swiper a[href^="#"]', function(e){
      e.preventDefault();
      var target = $($(this).attr('href'));
      if (target.length){
        // calculate offset (if you have fixed header, subtract its height)
        var headerOffset = 90; // adjust if your layout has a fixed topbar
        var offsetTop = target.offset().top - headerOffset;
        $('html, body').animate({ scrollTop: offsetTop }, 550);
        // set active slide visually in swiper
        var slide = $(this).closest('.swiper-slide')[0];
        if(slide){
          categorySwiper.slideTo(categorySwiper.slides.indexOf(slide), 300);
          // add focus for accessibility
          $(slide).focus();
        }
      }
    });

    // If user navigates with keyboard on swiper slides -> follow to section with Enter/Space
    $(document).on('keydown', '.category-swiper .swiper-slide', function(e){
      if(e.key === 'Enter' || e.key === ' '){
        e.preventDefault();
        $(this).find('a')[0].click();
      }
    });

    // Optional: highlight active category based on scroll position
    var sectionOffsets = [];
    function computeOffsets(){
      sectionOffsets = [];
      $('[id^="product-series-"]').each(function(){
        sectionOffsets.push({
          id: this.id,
          top: $(this).offset().top
        });
      });
    }
    computeOffsets();
    $(window).on('resize', computeOffsets);

    $(window).on('scroll', function(){
      var scroll = $(window).scrollTop() + 120; // offset for header-like elements
      for(var i = sectionOffsets.length-1; i>=0; i--){
        if(scroll >= sectionOffsets[i].top){
          var id = sectionOffsets[i].id;
          // find corresponding slide and make it active visually
          var $slide = $('.category-swiper .swiper-slide').filter(function(){
            return $(this).find('a').attr('href') === "#" + id;
          }).first();
          if($slide.length){
            var idx = categorySwiper.slides.indexOf($slide[0]);
            if(typeof idx === 'number' && idx >= 0){
              categorySwiper.slideTo(idx, 250);
            }
          }
          break;
        }
      }
    });
</script>
